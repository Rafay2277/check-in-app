{
  "expo": {
    "name": "Fourtillfour",
    "slug": "checkin-member",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "checkin",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fourtillfour.checkin",
      "buildNumber": "17",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "package": "com.fourtillfour.checkin",
      "versionCode": 14
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#111111",
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "apiBaseUrl": "https://dashboard.nouraiz.com",
      "privacyPolicyUrl": "https://fourtillfour.com/pages/app-privacy-policy",
      "termsOfUseUrl": "https://fourtillfour.com/pages/app-terms-of-use",
      "supportUrl": "https://fourtillfour.com/pages/app-support",
      "router": {},
      "eas": {
        "projectId": "63932906-c9e5-41aa-b115-48e2067d66e4"
      }
    },
    "owner": "rafaysial"
  }
}
