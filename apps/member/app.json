{
  "expo": {
    "name": "fourtillfour Check-In",
    "slug": "checkin-member",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "checkin",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.checkin.member"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "package": "com.checkin.member"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "https://dashboard.nouraiz.com",
      "router": {},
      "eas": {
        "projectId": "63932906-c9e5-41aa-b115-48e2067d66e4"
      }
    },
    "owner": "rafaysial"
  }
}
