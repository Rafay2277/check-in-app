# Server
NODE_ENV=development
PORT=3000
HTTPS_PORT=3443
PUBLIC_BASE_URL=http://localhost:3000
# Use HTTPS URL for staff scanner camera access on phones / LAN Chrome
PUBLIC_HTTPS_BASE_URL=https://192.168.0.188:3443

# PostgreSQL (local docker-compose defaults — use Supabase URI in production)
DATABASE_URL=postgres://checkin:checkin@localhost:5432/checkin
# Production (Hostinger) example:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Staff scanner (shared shift PIN)
STAFF_PIN=1234
STAFF_SESSION_TTL_SECONDS=43200

# Default phone country for normalization
DEFAULT_PHONE_COUNTRY=US

# V1 demo: skip Twilio SMS — login = name + phone + GHL contact match
SKIP_SMS_OTP=true

# When true, Twilio + GHL calls are mocked (local demo without credentials)
# Set false + fill GHL_* below to write real loyalty points into GoHighLevel
MOCK_INTEGRATIONS=true

# Twilio (only required when SKIP_SMS_OTP=false and MOCK_INTEGRATIONS=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# GoHighLevel API v2 (required when MOCK_INTEGRATIONS=false)
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
# Exact custom field key for check-in / loyalty points (from GHL)
# Merge field {{ contact.checkin_points }} → use checkin_points
GHL_POINTS_FIELD_KEY=
# Optional but preferred: custom field id from GHL (more reliable than key)
GHL_POINTS_FIELD_ID=
# Last check-in date on the GHL contact ({{ contact.checkin_date }})
GHL_CHECKIN_DATE_FIELD_KEY=checkin_date
GHL_CHECKIN_DATE_FIELD_ID=

# Outbox worker
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_MAX_ATTEMPTS=8
