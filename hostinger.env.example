# Hostinger workaround: panel env vars often do not persist.
#
# 1. In File Manager open: domains/dashboard.nouraiz.com/
# 2. Create folder "private" if missing
# 3. Create file: private/checkin.env
# 4. Paste the template below, fill in YOUR secrets, Save
# 5. Redeploy / Restart the Node app
#
# Do NOT commit private/checkin.env to git.
#
# GHL Private Integration scopes needed for Check-ins history:
#   contacts.readonly, contacts.write
#   objects/record.write
#   associations/relation.write
#   associations.readonly (optional — auto-resolves association id)

NODE_ENV=production
PUBLIC_BASE_URL=https://dashboard.nouraiz.com
SKIP_MIGRATE_ON_START=true
SKIP_SMS_OTP=true
MOCK_INTEGRATIONS=false

DB_USER=postgres.your-supabase-project-ref
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

JWT_ACCESS_SECRET=generate-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=generate-another-long-random-string-min-32-chars
STAFF_PIN=your-strong-staff-pin

GHL_ACCESS_TOKEN=pit-your-private-integration-token
GHL_LOCATION_ID=your-ghl-location-id
GHL_POINTS_FIELD_KEY=checkin_points
GHL_POINTS_FIELD_ID=your-ghl-points-field-id
GHL_CHECKIN_DATE_FIELD_KEY=checkin_date
GHL_CHECKIN_DATE_FIELD_ID=your-ghl-checkin-date-field-id
GHL_CHECKIN_OBJECT_KEY=custom_objects.check_ins
GHL_CHECKIN_OBJECT_DATE_FIELD_KEY=checkin_date
GHL_CHECKIN_OBJECT_POINTS_FIELD_KEY=points_total
GHL_CHECKIN_OBJECT_NAME_FIELD_KEY=check_in
GHL_CHECKIN_ASSOCIATION_ID=your-contact-checkins-association-id
